# Copy this file to .env (at the repo root) and fill in your keys.
# .env is git-ignored. Lesson scripts look for it next to themselves and in every parent folder.

# ---------- Russian letters and syllables (lessons/russian/tools/speak.py, record_server.py) ----------

# TTS service: elevenlabs (default) or openai
# TTS_PROVIDER=elevenlabs

# ElevenLabs — key: https://elevenlabs.io/app/settings/api-keys
# Voice Library voices are available via the API only on a paid plan (Starter is enough).
ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_MODEL=eleven_flash_v2_5        # or eleven_multilingual_v2 / eleven_v3
# ELEVENLABS_VOICE=d60rsXo2p0OwikDR5bS7     # Olga Orlova; get another voice ID from the Voice Library
# ELEVENLABS_CONSONANT_SUFFIX=ъ             # suffix appended to a consonant letter

# OpenAI — key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# OPENAI_TTS_MODEL=gpt-4o-mini-tts      # or tts-1 / tts-1-hd
# OPENAI_TTS_VOICE=nova                 # alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer, verse

# ---------- English words (lessons/english/tools/speak.py) — same keys ----------
# Separate settings so the English voice doesn't clash with the Russian one above.
# EN_TTS_PROVIDER=elevenlabs                # or openai
# EN_ELEVENLABS_VOICE=EXAVITQu4vr4xnSDxMaL  # Sarah; list voices: python3 lessons/english/tools/speak.py --voices
# EN_ELEVENLABS_MODEL=eleven_multilingual_v2
# EN_OPENAI_TTS_MODEL=gpt-4o-mini-tts
# EN_OPENAI_TTS_VOICE=coral

# ---------- Pictures (draw.py) — same OPENAI_API_KEY ----------

# OPENAI_IMAGE_MODEL=gpt-image-1-mini
# OPENAI_IMAGE_QUALITY=low              # low / medium / high

# ---------- Riddles (lessons/riddles/tools/prepare.py) — same OPENAI_API_KEY ----------

# OPENAI_TEXT_MODEL=gpt-5.5             # splits riddle lines, adds «ё» and SpeechKit stress marks

# Yandex SpeechKit — API key of a service account with the ai.speechkit-tts.user role:
# https://console.yandex.cloud → service account → «Создать API-ключ». No folder ID is needed with such a key.
YANDEX_API_KEY=AQVN...
# YANDEX_VOICE=filipp                   # API v1 voices: filipp, ermil, zahar, alena, jane, marina, omazh
# YANDEX_EMOTION=good                   # neutral / good
# YANDEX_SPEED=0.9                      # 0.1–3.0
